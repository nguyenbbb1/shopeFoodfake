<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".LuckyWheelActivity">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/wheelHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Quay lại"
            android:focusable="true"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvWheelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="🎡 Vòng Quay May Mắn 1 Tỷ"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/wheelHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Wallet Balance Badge -->
            <TextView
                android:id="@+id/tvWalletBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#262626"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="💳 Số dư Ví: 500.000 VNĐ"
                android:textColor="#FFD54F"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Jackpot Status Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardJackpotStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#212121"
                app:cardCornerRadius="12dp"
                app:strokeColor="#FFC107"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvJackpotStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="🎡 Vòng Quay May Mắn - Giải Đặc Biệt 1 TỶ ĐỒNG!"
                    android:textColor="#FFECB3"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Custom Lucky Wheel View -->
            <com.example.shopefoodfake.WheelView
                android:id="@+id/wheelView"
                android:layout_width="320dp"
                android:layout_height="320dp"
                android:layout_marginTop="16dp" />

            <!-- Remaining Spin Count -->
            <TextView
                android:id="@+id/tvSpinCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Số lượt quay còn lại: 3"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Spin Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpin"
                android:layout_width="220dp"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#EE4D2D"
                android:text="QUAY NGAY!"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="28dp" />

            <!-- Topup / Wallet Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTopupWallet"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="💳 Ví tiền cá nhân"
                android:textColor="#FFC107"
                app:cornerRadius="20dp"
                app:strokeColor="#FFC107" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>